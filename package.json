{
  "name": "vscode-file-size",
  "displayName": "File Size Explorer",
  "description": "Right-click a file or folder in the Explorer to see its size. Works in Remote-SSH.",
  "version": "0.0.1",
  "publisher": "your-publisher",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-publisher/vscode-file-size.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fileSizeExplorer.showSize",
        "title": "%command.showSize.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "fileSizeExplorer.showSize",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --external:vscode --format=cjs --platform=node --sourcemap --outfile=dist/extension.js",
    "watch": "npm run compile -- --watch",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}